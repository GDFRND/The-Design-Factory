# ─── AI providers (server-only, never NEXT_PUBLIC) ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
# Slugs verified live against openrouter.ai/models 2026-07-11 — the
# -preview suffixes have been promoted; the bare slugs are current.
# Fallback if a slug ever 404s: google/gemini-2.5-flash-image
IMAGE_MODEL_DRAFT=google/gemini-3.1-flash-image
IMAGE_MODEL_FINAL=google/gemini-3-pro-image
IMAGE_VARIANT_COUNT=4
MONTHLY_GENERATION_QUOTA=30
# Optional but recommended by OpenRouter — used for their app-attribution
# leaderboard and abuse handling. Not secret.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=The Design Factory
# ─── infra ───
DATABASE_URL=
SESSION_SECRET=
APP_URL=http://localhost:3000

# ─── optional integrations (leave empty until needed) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="The Design Factory <no-reply@example.com>"
