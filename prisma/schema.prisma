// The Design Factory — data model (BRIEF §3).
// Every query is scoped by workspaceId derived from the session,
// enforced by withWorkspace() in lib/workspace.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------- auth

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  name            String
  phone           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  memberships     Membership[]
  sessions        Session[]
  assignments     Assignment[]
  conversations   Conversation[]
  approvals       Approval[]      @relation("reviewer")
  authoredTickets SupportTicket[] @relation("ticketAuthor")
  assignedTickets SupportTicket[] @relation("ticketAssignee")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

enum Role {
  HOTEL_MARKETER
  HOTEL_APPROVER
  CREATIVE_SUPPORT_ASSISTANT
  ADMIN
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role
  isOwner     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ------------------------------------------------------------ workspace

model Workspace {
  id           String   @id @default(cuid())
  hotelName    String
  slug         String   @unique
  county       String?
  propertyType String?
  roomCount    Int?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships   Membership[]
  assignments   Assignment[]
  profile       HotelProfile?
  brandAssets   BrandAsset[]
  brandSystem   BrandSystem?
  conversations Conversation[]
  generations   Generation[]
  tickets       SupportTicket[]
}

// Creative Support Assistant carries 5–10 properties.
model Assignment {
  id          String    @id @default(cuid())
  assistantId String
  workspaceId String
  createdAt   DateTime  @default(now())
  assistant   User      @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([assistantId, workspaceId])
  @@index([workspaceId])
}

model HotelProfile {
  workspaceId     String    @id
  location        String?
  roomCategories  String[]
  restaurant      String?
  conference      String?
  wellness        String?
  spa             String?
  buffet          String?
  targetCustomers String[]
  sellingPoints   String[]
  seasonalOffers  String[]
  contact         String?
  bookingUrl      String?
  socials         Json?
  websiteUrl      String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum BrandAssetKind {
  LOGO
  GUIDELINES
  FONT
  PHOTOGRAPHY
  POSTER
  SOCIAL_SAMPLE
  MENU
  ROOM_IMAGE
  BROCHURE
  PAST_CAMPAIGN
  WEBSITE_SHOT
  REFERENCE
}

model BrandAsset {
  id          String         @id @default(cuid())
  workspaceId String
  kind        BrandAssetKind
  storageKey  String
  mime        String
  bytes       Int
  extracted   Json?
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
}

model BrandSystem {
  workspaceId    String    @id
  palette        Json?
  typography     Json?
  imageStyle     String?
  toneOfVoice    String?
  layoutApproach String?
  campaignStyle  String?
  provisional    Boolean   @default(true)
  completion     Int       @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------- ai

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        Json
  attachments    String[]
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum OutputKind {
  IMAGE
  TEXT
  COMPOSITE
}

enum GenerationStatus {
  PENDING
  EXPANDING
  READY
  GENERATING
  COMPLETE
  FAILED
}

model Generation {
  id             String           @id @default(cuid())
  workspaceId    String
  conversationId String?
  assetType      String
  outputKind     OutputKind
  rawBrief       String
  expandedPrompt Json?
  status         GenerationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants       Variant[]

  @@index([workspaceId, createdAt])
}

model Variant {
  id           String     @id @default(cuid())
  generationId String
  imageKey     String?
  copy         Json?
  selected     Boolean    @default(false)
  refinements  Json[]
  createdAt    DateTime   @default(now())
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  approvals    Approval[]

  @@index([generationId])
}

// --------------------------------------------------------------- review

enum ApprovalStage {
  SUPPORT_REVIEW
  HOTEL_APPROVAL
}

enum ApprovalDecision {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}

model Approval {
  id         String           @id @default(cuid())
  variantId  String
  stage      ApprovalStage
  reviewerId String
  decision   ApprovalDecision @default(PENDING)
  note       String?
  token      String           @unique @default(cuid()) // magic-link token
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?
  variant    Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reviewer   User             @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([reviewerId, decision])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id          String       @id @default(cuid())
  workspaceId String
  authorId    String
  assigneeId  String?
  body        String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User         @relation("ticketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("ticketAssignee", fields: [assigneeId], references: [id])

  @@index([workspaceId, status])
}
