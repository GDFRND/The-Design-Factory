# The Design Factory — local demo defaults. Safe to commit: no secrets.
# `npm run demo` copies this to .env on first run.

DATABASE_URL=postgresql://tdf:tdf@localhost:5799/tdf
SESSION_SECRET=local-demo-secret-change-for-real-use
APP_URL=http://localhost:3100
APP_ENV=demo

IMAGE_MODEL_DRAFT=google/gemini-3.1-flash-image
IMAGE_MODEL_FINAL=google/gemini-3-pro-image
IMAGE_VARIANT_COUNT=4

# Optional — paste your own keys here for real AI generation. Without them
# the app uses built-in offline fallbacks and the demo still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
